51.n = int(input("Enter number: "))
temp = n
rev = 0

while n:
    rev = rev*10 + n%10
    n //= 10

if temp == rev:
    print("Palindrome")
else:
    print("Not Palindrome")



52.n = int(input("Enter number: "))

while n != 1 and n != 4:
    s = 0
    while n:
        d = n % 10
        s += d*d
        n //= 10
    n = s

if n == 1:
    print("Happy Number")
else:
    print("Not Happy Number")




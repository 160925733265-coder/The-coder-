68.n = int(input("Enter number: "))
temp = n
digits = len(str(n))
s = 0

while temp:
    d = temp % 10
    s += d ** digits
    temp //= 10

if s == n:
    print("Armstrong Number")
else:
    print("Not Armstrong Number")




74.import math

x = float(input("Enter x: "))
n = int(input("Enter terms: "))
s = 0

for i in range(n):
    p = 2*i + 1
    term = x**p / math.factorial(p)

    if i % 2 == 0:
        s += term
    else:
        s -= term

print("Sum =", s)




75.def palindrome(s):
    if len(s) <= 1:
        return True
    return s[0] == s[-1] and palindrome(s[1:-1])

s = input("Enter string: ")

if palindrome(s):
    print("Palindrome")
else:
    print("Not Palindrome")




76.def count_vowels(s):
    if s == "":
        return 0

    if s[0].lower() in "aeiou":
        return 1 + count_vowels(s[1:])
    return count_vowels(s[1:])

s = input("Enter string: ")
print("Vowels =", count_vowels(s))




77.def pattern(n, i=1):
    if i > n:
        return

    print(i, end=" ")
    pattern(n, i+1)
    print(i, end=" ")

n = int(input("Enter N: "))
pattern(n)




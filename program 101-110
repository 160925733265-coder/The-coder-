107.n = 4
a = [[0]*n for _ in range(n)]

top, bottom = 0, n-1
left, right = 0, n-1
x = 1

while top <= bottom:
    for j in range(left, right+1):
        a[top][j] = x
        x += 1
    top += 1

    for i in range(top, bottom+1):
        a[i][right] = x
        x += 1
    right -= 1

    for j in range(right, left-1, -1):
        a[bottom][j] = x
        x += 1
    bottom -= 1

    for i in range(bottom, top-1, -1):
        a[i][left] = x
        x += 1
    left += 1

for row in a:
    print(*row)



